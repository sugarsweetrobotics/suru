{
  "name": "suru",
  "displayName": "する",
  "description": "日本語の関数型プログラミング言語「する」の色分け・書きながらの型の検査・型のホバー・定義へ移動・補完・名前の変更・実行・kumu(プロジェクトの実行・試験・点検)",
  "version": "0.10.0",
  "publisher": "suru-lang",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/suru-lang/suru",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/suru-lang/suru/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/suru-lang/suru/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "suru",
    "する",
    "日本語",
    "Japanese",
    "programming language"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "suru",
        "aliases": [
          "する",
          "suru"
        ],
        "extensions": [
          ".suru"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "suru",
        "scopeName": "source.suru",
        "path": "./syntaxes/suru.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "suru.run",
        "title": "このファイルを実行する",
        "category": "する",
        "icon": "$(play)"
      },
      {
        "command": "suru.check",
        "title": "型を検査する",
        "category": "する",
        "icon": "$(check)"
      },
      {
        "command": "suru.compile",
        "title": "バイナリを作る",
        "category": "する",
        "icon": "$(package)"
      },
      {
        "command": "suru.kumuRun",
        "title": "プロジェクトを実行する(kumu 実行)",
        "category": "する",
        "icon": "$(run-all)"
      },
      {
        "command": "suru.kumuBuild",
        "title": "プロジェクトを組む(kumu 作る)",
        "category": "する",
        "icon": "$(tools)"
      },
      {
        "command": "suru.kumuTest",
        "title": "プロジェクトを試験する(kumu 試験)",
        "category": "する",
        "icon": "$(beaker)"
      },
      {
        "command": "suru.kumuCheck",
        "title": "プロジェクトを点検する(kumu 点検)",
        "category": "する",
        "icon": "$(checklist)"
      },
      {
        "command": "suru.kumuFetch",
        "title": "依存を取ってくる(kumu 取得)",
        "category": "する",
        "icon": "$(cloud-download)"
      },
      {
        "command": "suru.kumuTestOne",
        "title": "この試験を動かす(kumu 試験)",
        "category": "する"
      },
      {
        "command": "suru.restartServer",
        "title": "言語サーバーを再起動する",
        "category": "する"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "suru.run",
          "when": "editorLangId == suru",
          "group": "navigation@1"
        },
        {
          "command": "suru.compile",
          "when": "editorLangId == suru",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "suru.run",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.check",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.compile",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.restartServer",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuRun",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuBuild",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuTest",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuCheck",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuFetch",
          "when": "editorLangId == suru"
        },
        {
          "command": "suru.kumuTestOne",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "suru.run",
        "key": "f5",
        "when": "editorLangId == suru && !inDebugMode"
      }
    ],
    "configuration": {
      "title": "する",
      "properties": {
        "suru.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "「する」を動かすコマンド(例: `suru`、`python3 /path/to/suru.py`)。空のときは、開いているフォルダーの一番上に `suru.py` があればそれを、なければ pip で入れた `suru` を使います。"
        },
        "suru.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "`suru.py` を動かす Python(空のときは Windows で `python`、それ以外で `python3`)。"
        },
        "suru.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "言語サーバーが使えないとき、ファイルを開いたときと保存したときに suru --検査 で型を調べて、間違いを「問題」に表示する"
        },
        "suru.languageServer": {
          "type": "string",
          "default": "",
          "markdownDescription": "言語サーバー `suru-ls` の場所。空のときは、拡張に同梱のもの、PATH の `suru-ls`、`~/go/bin/suru-ls` の順に探します。`off` にすると使いません(保存したときだけ `suru --検査` で調べます)。"
        },
        "suru.kumu": {
          "type": "string",
          "default": "",
          "markdownDescription": "プロジェクト管理の `kumu` の場所。空のときは PATH、`~/go/bin/kumu` の順に探します。"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
